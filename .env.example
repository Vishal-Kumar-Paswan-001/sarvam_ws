# Copy to `.env.local` for local dev, and set the same keys in the Vercel
# dashboard (Project > Settings > Environment Variables). NEVER commit this file.

# --- required ---
# Password to reach the app (share, view, reader, demo).
APP_PASSWORD=change-me-to-a-long-random-passphrase
# Secret used to sign the session cookie. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-hex-string

# --- Sarvam (voice + document reading) ---
# Rotate the key you shared in chat first, then paste the fresh one here only.
SARVAM_API_KEY=
# TTS model + voice (see Sarvam docs for the voice list).
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
SARVAM_TTS_LANGUAGE=en-IN

# --- Redis (required for cross-instance state on Vercel) ---
# Either naming scheme works:
#  - manual Upstash: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#  - Vercel KV / Marketplace integration: KV_REST_API_URL / KV_REST_API_TOKEN
# (The integration injects the KV_* names automatically.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- optional: TURN for cross-network WebRTC media ---
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
